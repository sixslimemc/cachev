
type EvalId = string
type EvalInput = any
type EvalOutput = any
type EvalReturn = int

type CacheKey = (string | int)

struct CacheEntry {
    out: EvalOutput,
    return: EvalReturn,
}

struct Cache {
    [EvalId]: struct {
        [CacheKey]: [CacheEntry] @ 1..
    }
}

struct EvalDefinition {
    id: EvalId,
    command: #[command] string,
}