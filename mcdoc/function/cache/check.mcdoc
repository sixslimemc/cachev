
use super::super::super::def::EvalId
use super::super::super::def::EvalInput
use super::super::super::def::EvalOutput
use super::super::super::def::EvalReturn

struct In {
    id: EvalId,
    input: EvalInput,
}

struct Out {
    result?: struct CachedEntry {
        out: EvalOutput,
        return: EvalReturn,
    }
}

enum(int) Return {
    Cached = 1,
    NotCached = 0,
}